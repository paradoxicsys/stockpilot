# Copy to terraform.tfvars and adjust. terraform.tfvars is git-ignored.
# AWS credentials are NOT set here: use `aws configure` / AWS SSO / env vars.

region             = "ap-south-1"
project            = "stockpilot"
kubernetes_version = "1.36"

node_instance_types = ["t3.medium"]
node_desired_size   = 3
node_min_size       = 2
node_max_size       = 4

# "your-github-user/stockpilot" enables keyless deploys from GitHub Actions
github_repository           = ""
create_github_oidc_provider = true

# If GitHub issues immutable OIDC subjects for your repo, set the prefix from:
#   gh api repos/<owner>/<repo>/actions/oidc/customization/sub --jq .sub_claim_prefix
github_oidc_sub_prefix = ""
